<Window x:Class="Wff.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="win-fast-finder settings" Height="560" Width="600"
        WindowStartupLocation="CenterScreen"
        Icon="{DynamicResource AppLogo}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Click="Save_Click" Padding="16,2" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Padding="16,2" IsCancel="True"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Image Source="{DynamicResource AppLogo}" Width="28" Height="28" Margin="0,0,8,0"/>
            <TextBlock Text="win-fast-finder settings" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="8">
                    <CheckBox x:Name="LaunchBox" Content="Launch at Windows login" Margin="0,4,0,0"/>
                    <TextBlock Opacity="0.6" Text="Uses your own startup entry (no admin). Untick to opt out." Margin="20,0,0,8"/>
                    <TextBlock Text="Theme:" FontWeight="Bold"/>
                    <ComboBox x:Name="ThemeBox" Width="160" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <ComboBoxItem>System</ComboBoxItem>
                        <ComboBoxItem>Light</ComboBoxItem>
                        <ComboBoxItem>Dark</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="FullscreenBox" Content="Ignore hotkeys in fullscreen games/apps" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Hotkeys">
                <StackPanel Margin="8">
                    <TextBlock Text="Main hotkey (e.g. Ctrl+Shift+F, Alt+Space):" FontWeight="Bold"/>
                    <TextBox x:Name="HotkeyBox" Padding="4" Margin="0,4,0,0"/>
                    <TextBlock x:Name="HotkeyError" Foreground="Red" Visibility="Collapsed" Margin="0,2,0,0"/>
                    <CheckBox x:Name="DoubleTapBox" Content="Ctrl double-tap also summons" Margin="0,8,0,0"/>
                    <TextBlock Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="A modifier is required. Changes apply after Save (re-registers the hotkey)."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Search">
                <StackPanel Margin="8">
                    <TextBlock Text="Max results:" FontWeight="Bold"/>
                    <ComboBox x:Name="MaxBox" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <ComboBoxItem>10</ComboBoxItem>
                        <ComboBoxItem>25</ComboBoxItem>
                        <ComboBoxItem>50</ComboBoxItem>
                        <ComboBoxItem>100</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="PathBox" Content="Match full path, not just filenames" Margin="0,8,0,0"/>
                    <TextBlock Text="Sort:" FontWeight="Bold" Margin="0,8,0,0"/>
                    <ComboBox x:Name="SortBox" Width="160" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <ComboBoxItem>rank</ComboBoxItem>
                        <ComboBoxItem>name</ComboBoxItem>
                        <ComboBoxItem>date</ComboBoxItem>
                        <ComboBoxItem>size</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="HiddenBox" Content="Hide hidden and system files" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Index">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock x:Name="StatsLine" Opacity="0.6"/>
                        <TextBlock Text="Disks — tick to ignore:" FontWeight="Bold" Margin="0,8,0,0"/>
                        <StackPanel x:Name="DrivePanel" Margin="0,4,0,0"/>
                        <TextBlock Text="Folders to ignore — paste the full address:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button Content="Add" Click="FolderAdd_Click" Padding="12,2" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBox x:Name="FolderBox" Padding="4"/>
                        </DockPanel>
                        <TextBlock x:Name="FolderError" Foreground="Red" Visibility="Collapsed" Margin="0,2,0,0"/>
                        <ListBox x:Name="FolderList" Height="90" Margin="0,4,0,0"/>
                        <Button Content="Remove selected" Click="FolderRemove_Click" Padding="8,0"
                                HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <TextBlock Text="Roots to index (empty = your profile):" FontWeight="Bold" Margin="0,10,0,0"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button Content="Add" Click="RootAdd_Click" Padding="12,2" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBox x:Name="RootBox" Padding="4"/>
                        </DockPanel>
                        <TextBlock x:Name="RootError" Foreground="Red" Visibility="Collapsed" Margin="0,2,0,0"/>
                        <ListBox x:Name="WhiteList" Height="70" Margin="0,4,0,0"/>
                        <Button Content="Remove selected" Click="RootRemove_Click" Padding="8,0"
                                HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <TextBlock Text="Extensions to ignore — tick from your files:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ExtEmpty" Opacity="0.6" Text="Index not ready yet — search once, then reopen." Visibility="Collapsed"/>
                        <StackPanel x:Name="ExtPanel" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Advanced">
                <StackPanel Margin="8">
                    <Button Content="Export settings backup…" Click="Export_Click" Padding="10,4" HorizontalAlignment="Left"/>
                    <Button Content="Import settings backup…" Click="Import_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ImportError" Foreground="Red" Visibility="Collapsed" Margin="0,4,0,0"/>
                    <Button Content="Reset to defaults" Click="Reset_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <Button Content="Open data folder" Click="DataFolder_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <Button Content="View log" Click="ViewLog_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <TextBlock x:Name="VersionLine" Opacity="0.6" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
